@model RegistroViewModel
@{
    ViewData["Title"] = "Perfil de Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - K_F_ClothingStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>
    <link rel="stylesheet" href="~/css/estilos_personalizados.css"/>



        <style>
        @@keyframes popIn {
            from { transform: scale(.92); opacity: 0; }
            to   { transform: scale(1);   opacity: 1; }
        }
        .alert-pop { animation: popIn .28s ease-out both; }

        @@keyframes shake {
            10%, 90% { transform: translateX(-1px); }
            20%, 80% { transform: translateX(2px); }
            30%, 50%, 70% { transform: translateX(-4px); }
            40%, 60% { transform: translateX(4px); }
        }
        .alert-shake { animation: shake .55s ease-in-out; }
    </style>
       
 
</head>

<body class="bg-light">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="text-center mb-4">👤 Perfil del Usuario</h2>

            @if (TempData["mensaje"] != null)
            {
                <div id="successAlert" class="alert alert-success alert-dismissible fade show text-center alert-pop">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["error"] != null)
            {
                <div id="errorAlert" class="alert alert-danger alert-dismissible fade show text-center alert-shake">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card profile-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0">Información Personal</h4>
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEditar">
                            <i class="fas fa-edit me-1"></i> Editar
                        </button>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-user me-2"></i>Nombre:</strong> @Model.Persona?.Nombre1 @Model.Persona?.Nombre2</p>
                            <p><strong><i class="fas fa-id-card me-2"></i>Apellidos:</strong> @Model.Persona?.Apellido1 @Model.Persona?.Apellido2</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-phone me-2"></i>Teléfono:</strong> @Model.Persona?.Telefono</p>
                            <p><strong><i class="fas fa-venus-mars me-2"></i>Género:</strong> @Model.Persona?.Genero</p>
                        </div>
                    </div>

                    <hr class="my-4">

                    <h5 class="mb-3"><i class="fas fa-map-marker-alt me-2"></i>Dirección</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Ciudad:</strong> @Model.Direccion?.Ciudad</p>
                            <p><strong>Estado:</strong> @Model.Direccion?.Estado</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Código Postal:</strong> @Model.Direccion?.CodigoPostal</p>
                            <p><strong>País:</strong> @Model.Direccion?.Pais</p>
                            <p><strong>Tipo:</strong> @Model.Direccion?.TipoDireccion</p>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar">
                            <i class="fas fa-trash-alt me-1"></i> Eliminar Cuenta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Editar Perfil -->
    <div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- SIN Tag Helpers: action fijo y names para model binding -->
                <form action="@Url.Action("GuardarPerfil","Cliente")" method="post" id="formEditar">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Editar Perfil</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">

                        <!-- Hidden IDs -->
                        <input type="hidden" name="Usuario.ID"   value="@Model.Usuario?.ID" />
                        <input type="hidden" name="Persona.ID"   value="@Model.Persona?.ID" />
                        <input type="hidden" name="Direccion.ID" value="@Model.Direccion?.ID" />
                        <input type="hidden" name="Cliente.ID"   value="@Model.Cliente?.ID" />

                        <!-- Datos de Usuario que no se editan aquí -->
                        <input type="hidden" name="Usuario.Email"          value="@Model.Usuario?.Email" />
                        <input type="hidden" name="Usuario.Rol"            value="@Model.Usuario?.Rol" />
                        <input type="hidden" name="Usuario.NombreUsuario"  value="@Model.Usuario?.NombreUsuario" /> <!-- requerido -->

                        <h6 class="mb-3 text-primary">Información Personal</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label>Primer Nombre</label>
                                <input name="Persona.Nombre1" class="form-control" required value="@Model.Persona?.Nombre1" />
                            </div>
                            <div class="col-md-6">
                                <label>Segundo Nombre</label>
                                <input name="Persona.Nombre2" class="form-control" value="@Model.Persona?.Nombre2" />
                            </div>
                            <div class="col-md-6">
                                <label>Primer Apellido</label>
                                <input name="Persona.Apellido1" class="form-control" required value="@Model.Persona?.Apellido1" />
                            </div>
                            <div class="col-md-6">
                                <label>Segundo Apellido</label>
                                <input name="Persona.Apellido2" class="form-control" value="@Model.Persona?.Apellido2" />
                            </div>
                            <div class="col-md-6">
                                <label>Teléfono</label>
                                <input name="Persona.Telefono" class="form-control" required value="@Model.Persona?.Telefono" />
                            </div>
                            <div class="col-md-6">
                                <label>Género</label>
                                <select name="Persona.Genero" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Masculino" @(Model.Persona?.Genero=="Masculino"?"selected":null)>Masculino</option>
                                    <option value="Femenino"  @(Model.Persona?.Genero=="Femenino" ?"selected":null)>Femenino</option>
                                    <option value="Otro"      @(Model.Persona?.Genero=="Otro"     ?"selected":null)>Otro</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h6 class="mb-3 text-primary">Dirección</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label>Ciudad</label>
                                <input name="Direccion.Ciudad" class="form-control" required value="@Model.Direccion?.Ciudad" />
                            </div>
                            <div class="col-md-6">
                                <label>Estado</label>
                                <input name="Direccion.Estado" class="form-control" required value="@Model.Direccion?.Estado" />
                            </div>
                            <div class="col-md-6">
                                <label>Código Postal</label>
                                <input name="Direccion.CodigoPostal" class="form-control" required value="@Model.Direccion?.CodigoPostal" />
                            </div>
                            <div class="col-md-6">
                                <label>País</label>
                                <input name="Direccion.Pais" class="form-control" required value="@Model.Direccion?.Pais" />
                            </div>
                            <div class="col-12">
                                <label>Tipo de Dirección</label>
                                <select name="Direccion.TipoDireccion" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Casa"    @(Model.Direccion?.TipoDireccion=="Casa"   ?"selected":null)>Casa</option>
                                    <option value="Trabajo" @(Model.Direccion?.TipoDireccion=="Trabajo"?"selected":null)>Trabajo</option>
                                    <option value="Otro"    @(Model.Direccion?.TipoDireccion=="Otro"   ?"selected":null)>Otro</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardar">
                            <span class="spinner-border spinner-border-sm me-2 d-none" id="spGuardar" role="status" aria-hidden="true"></span>
                            <span>Guardar Cambios</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Confirmar Eliminación -->
    <div class="modal fade delete-modal" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="@Url.Action("EliminarCuenta","Cliente")" method="post" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idUsuario" value="@Model.Usuario?.ID" />
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Eliminar Cuenta</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <i class="fas fa-trash-alt fa-4x text-danger mb-3"></i>
                        <h5>¿Estás seguro que deseas eliminar tu cuenta?</h5>
                        <p class="text-muted">Esta acción es irreversible.</p>
                        <input type="text" id="confirmText" class="form-control mt-3" placeholder="Escribe ELIMINAR para confirmar" required pattern="ELIMINAR"/>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger" id="btnConfirmarEliminar" disabled>Confirmar Eliminación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Confeti -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

<script>
    $(function () {
        // Habilitar/deshabilitar botón de eliminar según texto
        $('#confirmText').on('input', function () {
            $('#btnConfirmarEliminar').prop('disabled', $(this).val().toUpperCase() !== 'ELIMINAR');
        });

        // Validación simple y spinner al enviar
        $('#formEditar').on('submit', function (e) {
            let valid = true;
            $(this).find('[required]').each(function () {
                if (!$(this).val()) { $(this).addClass('is-invalid'); valid = false; }
                else { $(this).removeClass('is-invalid'); }
            });

            if (!valid) {
                e.preventDefault();
                alert('Por favor complete todos los campos requeridos.');
            } else {
                $('#btnGuardar').prop('disabled', true);
                $('#spGuardar').removeClass('d-none');
            }
        });

        // Animaciones de feedback
        const ok = document.getElementById('successAlert');
        const err = document.getElementById('errorAlert');

        if (ok && window.confetti) {
            confetti({ particleCount: 120, spread: 70, origin: { y: 0.25 } });
        }
        if (err && window.confetti) {
            confetti({ particleCount: 70, spread: 45, origin: { y: 0.25 }, colors: ['#dc3545', '#6c757d'] });
        }
    });
</script>

</body>
</html>
