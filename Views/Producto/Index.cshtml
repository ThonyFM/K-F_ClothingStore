@model IEnumerable<K_F_ClothingStore.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <div class="d-flex justify-content-between mb-4">
        <button type="button" class="btn btn-success" data-toggle="modal" data-target="#createModal">
            <i class="fas fa-plus"></i> Agregar Producto
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover" id="productosTable">
            <thead class="thead-dark">
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Género</th>
                <th>Talla</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                        {
                            <img src="@item.ImagenUrl" alt="@item.NombreProducto" class="img-thumbnail" style="max-width: 80px; max-height: 80px;">
                        }
                        else
                        {
                            <span class="text-muted">Sin imagen</span>
                        }
                    </td>
                    <td>@item.NombreProducto</td>
                    <td>@item.TipoProducto</td>
                    <td>@item.Genero</td>
                    <td>@item.Talla</td>
                    <td>@item.Precio.ToString("C")</td>
                    <td>@item.UnidadesDisponibles</td>
                    <td>
                        <button class="btn btn-info btn-sm" data-toggle="modal" data-target="#detailsModal"
                                onclick="loadDetails(@item.ID)">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#editModal"
                                onclick="loadEdit(@item.ID)">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deleteModal"
                                onclick="loadDelete(@item.ID)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Modals -->
@await Html.PartialAsync("_CreateModal")
@await Html.PartialAsync("_DetailsModal")
@await Html.PartialAsync("_EditModal")
@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <script>
        // Cargar modales
        function loadDetails(id) {
            $.get('@Url.Action("Details", "Producto")/' + id, function(data) {
                $('#detailsModalContent').html(data);
            });
        }

        function loadEdit(id) {
            $.get('@Url.Action("Edit", "Producto")/' + id, function(data) {
                $('#editModalContent').html(data);
            });
        }

        function loadDelete(id) {
            $.get('@Url.Action("Delete", "Producto")/' + id, function(data) {
                $('#deleteModalContent').html(data);
            });
        }

        // Manejar el envío de formularios via AJAX
        $(document).ready(function() {
            // Crear
            $('#createForm').on('submit', function(e) {
                e.preventDefault();
                var formData = new FormData(this);

                $.ajax({
                    url: '@Url.Action("Create", "Producto")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            $('#createModal').modal('hide');
                            location.reload();
                        }
                    }
                });
            });

            // Editar
            $('#editForm').on('submit', function(e) {
                e.preventDefault();
                var formData = new FormData(this);

                $.ajax({
                    url: '@Url.Action("Edit", "Producto")/' + $('#editForm #ID').val(),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            $('#editModal').modal('hide');
                            location.reload();
                        }
                    }
                });
            });

            // Eliminar
            $('#deleteForm').on('submit', function(e) {
                e.preventDefault();

                $.ajax({
                    url: '@Url.Action("Delete", "Producto")/' + $('#deleteForm #ID').val(),
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            $('#deleteModal').modal('hide');
                            location.reload();
                        }
                    }
                });
            });

            // Resetear formularios al cerrar modales
            $('.modal').on('hidden.bs.modal', function() {
                $(this).find('form')[0].reset();
                $(this).find('.custom-file-label').text('Seleccionar archivo...');
            });
        });
    </script>
}